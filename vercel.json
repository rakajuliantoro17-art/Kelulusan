{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/akademik/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/akademik/",
      "destination": "/src/akademik/index.html"
    },
    {
      "source": "/akademik",
      "destination": "/src/akademik/index.html"
    },
    {
      "source": "/akademik/assets/(.*)",
      "destination": "/src/akademik/assets/$1"
    },
    {
      "source": "/akademik/(.*)",
      "destination": "/src/akademik/$1"
    },
    {
      "source": "/api/akademik/kenaikan",
      "destination": "/api/akademik?op=kenaikan"
    },
    {
      "source": "/api/akademik/kelulusan",
      "destination": "/api/akademik?op=kelulusan"
    },
    {
      "source": "/api/akademik/nilai",
      "destination": "/api/akademik?op=nilai"
    },
    {
      "source": "/api/akademik/kelas-list",
      "destination": "/api/akademik?op=kelas-list"
    },
    {
      "source": "/api/akademik/kelas-summary",
      "destination": "/api/akademik?op=kelas-summary"
    },
    {
      "source": "/api/akademik/stats",
      "destination": "/api/akademik?op=stats"
    },
    {
      "source": "/kesiswaan",
      "destination": "/src/kesiswaan/index"
    },
    {
      "source": "/kesiswaan/",
      "destination": "/src/kesiswaan/index"
    },
    {
      "source": "/kesiswaan/(.*)",
      "destination": "/src/kesiswaan/$1"
    },
    {
