rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ======================================================
    // AUTH HELPERS
    // ======================================================

    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && request.auth.token.level == role;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isExecutive() {
      return hasRole("executive");
    }

    function isUser() {
      return hasRole("user");
    }

    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    // ======================================================
    // USERS
    // ======================================================

    match /users/{userId} {

      allow read:
        if isOwner(userId)
        || isAdmin()
        || isExecutive();

      allow create, update, delete:
        if isAdmin();

    }

    // ======================================================
    // MASTER DATA
    // ======================================================

    match /master/{collection}/{document} {

      allow read:
        if signedIn();

      allow write:
        if isAdmin();

    }

    // ======================================================
    // ASSETS
    // ======================================================

    match /assets/{assetId} {

      allow read:
        if signedIn();

      allow create:
        if (isAdmin() || isUser())
        && request.resource.data.assetCode is string
        && request.resource.data.assetName is string;

      allow update:
        if isAdmin() || isUser();

      allow delete:
        if isAdmin();

    }

    // ======================================================
    // MAINTENANCE
    // ======================================================

    match /maintenance/{id} {

      allow read:
        if signedIn();

      allow create, update:
        if isAdmin() || isUser();

      allow delete:
        if isAdmin();

    }

    // ======================================================
    // REPORTS
    // ======================================================

    match /reports/{id} {

      allow read:
        if signedIn();

      allow write:
        if isAdmin();

    }

    // ======================================================
    // NOTIFICATIONS
    // ======================================================

    match /notifications/{id} {

      allow read:
        if signedIn();

      allow create:
        if isAdmin();

      allow update:
        if signedIn();

      allow delete:
        if isAdmin();

    }

    // ======================================================
    // HISTORY
    // ======================================================

    match /history/{id} {

      allow read:
        if signedIn();

      allow create:
        if signedIn();

      allow update, delete:
        if isAdmin();

    }

    // ======================================================
    // AUDIT LOG
    // ======================================================

    match /audit_logs/{id} {

      allow read:
        if isAdmin() || isExecutive();

      allow create:
        if signedIn();

      allow update, delete:
        if false;

    }

    // ======================================================
    // BACKUP LOG
    // ======================================================

    match /backup_logs/{id} {

      allow read:
        if isAdmin();

      allow write:
        if isAdmin();

    }

    // ======================================================
    // DASHBOARD CACHE
    // ======================================================

    match /dashboardCache/{id} {

      allow read:
        if true;

      allow write:
        if isAdmin();

    }

    // ======================================================
    // SETTINGS
    // ======================================================

    match /settings/{id} {

      allow read:
        if signedIn();

      allow write:
        if isAdmin();

    }

    // ======================================================
    // DEFAULT
    // ======================================================

    match /{document=**} {

      allow read, write:
        if false;

    }

  }

}
